#################################################################
#    Data properties
#################################################################

###  https://kastle-lab.org/currkg/lod/ont/asString
<https://kastle-lab.org/currkg/lod/ont/asString> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <https://kastle-lab.org/currkg/lod/ont/Event>
                                                                             <https://kastle-lab.org/currkg/lod/ont/LearningPath>
                                                                             <https://kastle-lab.org/currkg/lod/ont/LearningStep>
                                                                             <https://kastle-lab.org/currkg/lod/ont/Persona>
                                                                             <https://kastle-lab.org/currkg/lod/ont/PersonaType>
                                                                             <https://kastle-lab.org/currkg/lod/ont/Profession>
                                                                             <https://kastle-lab.org/currkg/lod/ont/Topic>
                                                                           )
                                                             ] ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Provides a string lexicalization or label for a resource."@en ;
                                                 rdfs:label "as string"@en .


###  https://kastle-lab.org/currkg/lod/ont/hasMediaSourceLink
<https://kastle-lab.org/currkg/lod/ont/hasMediaSourceLink> rdf:type owl:DatatypeProperty ;
                                                           rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Media> ;
                                                           rdfs:range xsd:string ;
                                                           rdfs:comment "Provides the source link or URL string for a media resource."@en ;
                                                           rdfs:label "has media source link"@en .


###  https://kastle-lab.org/currkg/lod/ont/hasName
<https://kastle-lab.org/currkg/lod/ont/hasName> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Author> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Provides a human-readable name string for a resource."@en ;
                                                rdfs:label "has name"@en .


###  https://kastle-lab.org/currkg/lod/ont/hasTitle
<https://kastle-lab.org/currkg/lod/ont/hasTitle> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <https://kastle-lab.org/currkg/lod/ont/Curriculum>
                                                                             <https://kastle-lab.org/currkg/lod/ont/Media>
                                                                             <https://kastle-lab.org/currkg/lod/ont/Module>
                                                                           )
                                                             ] ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Provides a title string for a resource."@en ;
                                                 rdfs:label "has title"@en .


