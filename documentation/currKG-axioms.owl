[ rdf:type owl:AllDisjointClasses ;
   owl:members ( currkg:Article
                 currkg:CaseStudy
                 currkg:Figure
                 currkg:Formula
                 currkg:GlossaryItem
                 currkg:Lesson
                 currkg:Podcast
                 currkg:Section
                 currkg:Table
                 currkg:Transcript
                 currkg:Video
                 currkg:WorkedExample
               )
 ] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( currkg:Presentation
                currkg:Tutorial
                currkg:Workshop
              )
] .


