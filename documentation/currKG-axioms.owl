###  https://kastle-lab.org/currkg/lod/ontology#LearningPath
currkg:LearningPath rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty currkg:hasLearningStep ;
                                      owl:someValuesFrom currkg:LearningStep
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty currkg:isDeterminedBy ;
                                      owl:someValuesFrom currkg:Persona
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty currkg:scopedBy ;
                                      owl:someValuesFrom currkg:Curriculum
                                    ] ;
                    <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "299.49419969429334"^^xsd:double ;
