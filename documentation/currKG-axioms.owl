###  https://kastle-lab.org/currkg/lod/ontology#Media
currkg:Media rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:coversTopic ;
                               owl:someValuesFrom currkg:Topic
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasAuthor ;
                               owl:someValuesFrom currkg:Author
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasLanguage ;
                               owl:someValuesFrom currkg:Language
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasRecomended ;
                               owl:someValuesFrom currkg:Audience
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasMediaSourceLink ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasTitle ;
                               owl:someValuesFrom xsd:string
                             ] ;
             <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "56.22964736735543"^^xsd:double ;
                                                                          <http://ontologydesignpatterns.org/opla-sd#entityPositionY> "192.4576250484204"^^xsd:double ;
                                                                          rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en
                                                                        ] ;
             rdfs:comment "Represents a Media that is a learning resource (e.g., article, video, podcast, transcript) and can be referenced by modules or provided by events."@en ;
             rdfs:label "Media"@en ;
             currkg:isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/reporting-event> .


###  https://kastle-lab.org/currkg/lod/ontology#Module
currkg:Module rdf:type owl:Class ;
