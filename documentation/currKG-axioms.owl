@base <https://kastle-lab.org/currkg/lod/ontology#> .

<https://kastle-lab.org/currkg/lod/ontology#> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://ontologydesignpatterns.org/opla-sd#entityPosition
<http://ontologydesignpatterns.org/opla-sd#entityPosition> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#entityPositionX
<http://ontologydesignpatterns.org/opla-sd#entityPositionX> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#entityPositionY
<http://ontologydesignpatterns.org/opla-sd#entityPositionY> rdf:type owl:AnnotationProperty .


###  https://kastle-lab.org/currkg/lod/ont/isNativeTo
<https://kastle-lab.org/currkg/lod/ont/isNativeTo> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://kastle-lab.org/currkg/lod/ont/assumesAuthorship
<https://kastle-lab.org/currkg/lod/ont/assumesAuthorship> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Person> ;
                                                          rdfs:range <https://kastle-lab.org/currkg/lod/ont/Author> ;
                                                          rdfs:comment "Represents the relation of a person to an author role they assume."@en ;
                                                          rdfs:label "assumes authorship"@en .


###  https://kastle-lab.org/currkg/lod/ont/assumesPersona
<https://kastle-lab.org/currkg/lod/ont/assumesPersona> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Person> ;
                                                       rdfs:range <https://kastle-lab.org/currkg/lod/ont/Persona> ;
                                                       rdfs:comment "Represents the relation of a person to a persona role they assume."@en ;
                                                       rdfs:label "assumes persona"@en .


###  https://kastle-lab.org/currkg/lod/ont/belongTo
<https://kastle-lab.org/currkg/lod/ont/belongTo> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Module> ;
                                                 rdfs:comment "Represents the relation of a module to the category it belongs to."@en ;
                                                 rdfs:label "belongs to"@en .


###  https://kastle-lab.org/currkg/lod/ont/broaderThan
<https://kastle-lab.org/currkg/lod/ont/broaderThan> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Topic> ;
                                                    rdfs:range <https://kastle-lab.org/currkg/lod/ont/Topic> ;
                                                    rdfs:comment "Represents the relation of a topic to a broader (more general) topic."@en ;
                                                    rdfs:label "broader than"@en .


###  https://kastle-lab.org/currkg/lod/ont/coversTopic
<https://kastle-lab.org/currkg/lod/ont/coversTopic> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Class ;
                                                                  owl:unionOf ( <https://kastle-lab.org/currkg/lod/ont/Media>
                                                                                <https://kastle-lab.org/currkg/lod/ont/Module>
                                                                              )
                                                                ] ;
                                                    rdfs:range <https://kastle-lab.org/currkg/lod/ont/Topic> ;
                                                    rdfs:comment "Represents the relation of a module or media resource to a topic it covers."@en ;
                                                    rdfs:label "covers topic"@en .


###  https://kastle-lab.org/currkg/lod/ont/determines
<https://kastle-lab.org/currkg/lod/ont/determines> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Persona> ;
                                                   rdfs:range <https://kastle-lab.org/currkg/lod/ont/LearningPath> ;
                                                   rdfs:comment "Represents the relation of a persona to the learning path it determines."@en ;
                                                   rdfs:label "determines"@en .


###  https://kastle-lab.org/currkg/lod/ont/hasAuthor
<https://kastle-lab.org/currkg/lod/ont/hasAuthor> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://kastle-lab.org/currkg/lod/ont/Media> ;
                                                  rdfs:range <https://kastle-lab.org/currkg/lod/ont/Author> ;
                                                  rdfs:comment "Represents the relation of a media resource to its author."@en ;
