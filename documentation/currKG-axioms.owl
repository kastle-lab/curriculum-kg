@prefix : <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@base <https://kastle-lab.org/currkg/lod/ontology#> .

<https://kastle-lab.org/currkg/lod/ontology#> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://ontologydesignpatterns.org/opla-sd#entityPosition
<http://ontologydesignpatterns.org/opla-sd#entityPosition> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#entityPositionX
<http://ontologydesignpatterns.org/opla-sd#entityPositionX> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#entityPositionY
<http://ontologydesignpatterns.org/opla-sd#entityPositionY> rdf:type owl:AnnotationProperty .


###  https://kastle-lab.org/currkg/lod/ontology#isNativeTo
currkg:isNativeTo rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://id.cfainstitute.org/ns/addresses
<https://id.cfainstitute.org/ns/addresses> rdf:type owl:ObjectProperty ;
                                           rdfs:label "addresses"@en .


###  https://id.cfainstitute.org/ns/contrastsWith
<https://id.cfainstitute.org/ns/contrastsWith> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf currkg:related .


###  https://id.cfainstitute.org/ns/influences
<https://id.cfainstitute.org/ns/influences> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf currkg:related .


###  https://id.cfainstitute.org/ns/isDisclosedIn
<https://id.cfainstitute.org/ns/isDisclosedIn> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf currkg:related .


###  https://id.cfainstitute.org/ns/isbasisFor
<https://id.cfainstitute.org/ns/isbasisFor> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf currkg:related .


###  https://id.cfainstitute.org/ns/measures
<https://id.cfainstitute.org/ns/measures> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf currkg:related .


###  https://id.cfainstitute.org/ns/setsRequirementsFor
<https://id.cfainstitute.org/ns/setsRequirementsFor> rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf currkg:related .


###  https://kastle-lab.org/currkg/lod/ontology#assumesAuthorship
currkg:assumesAuthorship rdf:type owl:ObjectProperty ;
                         owl:inverseOf currkg:isAuthorshipOf ;
                         rdfs:domain currkg:Person ;
                         rdfs:range currkg:Author ;
                         rdfs:comment "Represents the relation of a person to an author role they assume."@en ;
                         rdfs:label "assumes authorship"@en .


###  https://kastle-lab.org/currkg/lod/ontology#assumesPersona
currkg:assumesPersona rdf:type owl:ObjectProperty ;
                      owl:inverseOf currkg:isPersonaOf ;
                      rdfs:domain currkg:Person ;
                      rdfs:range currkg:Persona ;
                      rdfs:comment "Represents the relation of a person to a persona role they assume."@en ;
                      rdfs:label "assumes persona"@en .


###  https://kastle-lab.org/currkg/lod/ontology#belongTo
currkg:belongTo rdf:type owl:ObjectProperty ;
                rdfs:domain currkg:Module ;
                rdfs:range currkg:Theme ;
                rdfs:comment "Represents the relation of a module to the category it belongs to."@en ;
                rdfs:label "belongs to"@en .


###  https://kastle-lab.org/currkg/lod/ontology#broaderThan
currkg:broaderThan rdf:type owl:ObjectProperty ;
                   owl:inverseOf currkg:narrowerThan ;
                   rdfs:domain currkg:Topic ;
                   rdfs:range currkg:Topic ;
                   rdfs:comment "Represents the relation of a topic to a broader (more general) topic."@en ;
                   rdfs:label "broader than"@en .


###  https://kastle-lab.org/currkg/lod/ontology#coversTopic
currkg:coversTopic rdf:type owl:ObjectProperty ;
                   owl:inverseOf currkg:isCoveredBy ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( currkg:Media
                                               currkg:Module
                                             )
                               ] ;
                   rdfs:range currkg:Topic ;
                   rdfs:comment "Represents the relation of a module or media resource to a topic it covers."@en ;
                   rdfs:label "covers topic"@en .


###  https://kastle-lab.org/currkg/lod/ontology#determines
currkg:determines rdf:type owl:ObjectProperty ;
                  owl:inverseOf currkg:isDeterminedBy ;
                  rdfs:domain currkg:Persona ;
                  rdfs:range currkg:LearningPath ;
                  rdfs:comment "Represents the relation of a persona to the learning path it determines."@en ;
                  rdfs:label "determines"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasAuthor
currkg:hasAuthor rdf:type owl:ObjectProperty ;
                 owl:inverseOf currkg:isAuthorOf ;
                 rdfs:domain currkg:Media ;
                 rdfs:range currkg:Author ;
                 rdfs:comment "Represents the relation of a media resource to its author."@en ;
                 rdfs:label "has author"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasLanguage
currkg:hasLanguage rdf:type owl:ObjectProperty ;
                   owl:inverseOf currkg:isLanguageOf ;
                   rdfs:domain currkg:Media ;
                   rdfs:range currkg:Language ;
                   rdfs:comment "Represents the relation of a media resource to the language it is in."@en ;
                   rdfs:label "has language"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasLearningStep
currkg:hasLearningStep rdf:type owl:ObjectProperty ;
                       owl:inverseOf currkg:isLearningStepOf ;
                       rdfs:domain currkg:LearningPath ;
                       rdfs:range currkg:LearningStep ;
                       rdfs:comment "Represents the relation of a learning path to a learning step that it contains."@en ;
                       rdfs:label "has learning step"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasLevel
currkg:hasLevel rdf:type owl:ObjectProperty ;
                owl:inverseOf currkg:isLevelOf ;
                rdfs:domain currkg:Module ;
                rdfs:range currkg:Level ;
                rdfs:comment "Represents the relation of a module to its difficulty level."@en ;
                rdfs:label "has level"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasModule
currkg:hasModule rdf:type owl:ObjectProperty ;
                 owl:inverseOf currkg:isModuleOf ;
                 rdfs:domain currkg:Curriculum ;
                 rdfs:range currkg:Module ;
                 rdfs:comment "Represents the relation of referring a curriculum to a module that is part of that curriculum."@en ;
                 rdfs:label "has module"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasNextLearningStep
currkg:hasNextLearningStep rdf:type owl:ObjectProperty ;
                           owl:inverseOf currkg:hasPreviousLearningStep ;
                           rdfs:domain currkg:LearningStep ;
                           rdfs:range currkg:LearningStep ;
                           rdfs:comment "Represents the relation of a learning step to the next learning step in the sequence."@en ;
                           rdfs:label "has next learning step"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasPreviousLearningStep
currkg:hasPreviousLearningStep rdf:type owl:ObjectProperty ;
                               rdfs:domain currkg:LearningStep ;
                               rdfs:range currkg:LearningStep ;
                               rdfs:comment "Represents the relation of a learning step to the previous learning step in the sequence."@en ;
                               rdfs:label "has previous learning step"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasProfession
currkg:hasProfession rdf:type owl:ObjectProperty ;
                     owl:inverseOf currkg:isProfessionOf ;
                     rdfs:domain currkg:Persona ;
                     rdfs:range currkg:Profession ;
                     rdfs:comment "Represents the relation of a persona to its profession."@en ;
                     rdfs:label "has profession"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasRecomended
currkg:hasRecomended rdf:type owl:ObjectProperty ;
                     owl:inverseOf currkg:isRecommendedFor ;
                     rdfs:domain currkg:Media ;
                     rdfs:range currkg:Audience ;
                     rdfs:comment "Represents the relation of a media resource to an intended audience it is recommended for."@en ;
                     rdfs:label "has recommended audience"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasSubEvent
currkg:hasSubEvent rdf:type owl:ObjectProperty ;
                   owl:inverseOf currkg:isSubEventOf ;
                   rdfs:domain currkg:Event ;
                   rdfs:range currkg:Event ;
                   rdfs:comment "Represents the relation of an event to a sub-event that is part of it."@en ;
                   rdfs:label "has sub-event"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasTheme
currkg:hasTheme rdf:type owl:ObjectProperty ;
                owl:inverseOf currkg:isThemeOf ;
                rdfs:domain currkg:Module ;
                rdfs:range currkg:Theme ;
                rdfs:comment "Relates a module to a theme that organizes its content."@en ;
                rdfs:label "has theme"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasType
currkg:hasType rdf:type owl:ObjectProperty ;
               owl:inverseOf currkg:isTypeOf ;
               rdfs:domain currkg:Persona ;
               rdfs:range currkg:PersonaType ;
               rdfs:comment "Represents the relation of a persona to its persona type."@en ;
               rdfs:label "has type"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isAuthorOf
currkg:isAuthorOf rdf:type owl:ObjectProperty ;
                  rdfs:domain currkg:Author ;
                  rdfs:range currkg:Media ;
                  rdfs:comment "Relates an author role to media authored in that role."@en ;
                  rdfs:label "is author of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isAuthorshipOf
currkg:isAuthorshipOf rdf:type owl:ObjectProperty ;
                      rdfs:domain currkg:Author ;
                      rdfs:range currkg:Person ;
                      rdfs:comment "Relates an author role to the person who assumes it."@en ;
                      rdfs:label "is authorship of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isCoveredBy
currkg:isCoveredBy rdf:type owl:ObjectProperty ;
                   rdfs:domain currkg:Topic ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:unionOf ( currkg:Media
                                              currkg:Module
                                            )
                              ] ;
                   rdfs:comment "Relates a topic to media or modules that cover it."@en ;
                   rdfs:label "is covered by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isDeterminedBy
currkg:isDeterminedBy rdf:type owl:ObjectProperty ;
                      rdfs:domain currkg:LearningPath ;
                      rdfs:range currkg:Persona ;
                      rdfs:comment "Relates a learning path to the persona that determines it."@en ;
                      rdfs:label "is determined by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isLanguageOf
currkg:isLanguageOf rdf:type owl:ObjectProperty ;
                    rdfs:domain currkg:Language ;
                    rdfs:range currkg:Media ;
                    rdfs:comment "Relates a language to media expressed in that language."@en ;
                    rdfs:label "is language of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isLearningStepOf
currkg:isLearningStepOf rdf:type owl:ObjectProperty ;
                        rdfs:domain currkg:LearningStep ;
                        rdfs:range currkg:LearningPath ;
                        rdfs:comment "Relates a learning step to the learning path that contains it."@en ;
                        rdfs:label "is learning step of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isLevelOf
currkg:isLevelOf rdf:type owl:ObjectProperty ;
                 rdfs:domain currkg:Level ;
                 rdfs:range currkg:Module ;
                 rdfs:comment "Relates a difficulty level to a module assigned that level."@en ;
                 rdfs:label "is level of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isModuleOf
currkg:isModuleOf rdf:type owl:ObjectProperty ;
                  rdfs:domain currkg:Module ;
                  rdfs:range currkg:Curriculum ;
                  rdfs:comment "Relates a module to the curriculum that contains it."@en ;
                  rdfs:label "is module of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isPersonaOf
currkg:isPersonaOf rdf:type owl:ObjectProperty ;
                   rdfs:domain currkg:Persona ;
                   rdfs:range currkg:Person ;
                   rdfs:comment "Relates a persona role to the person who assumes it."@en ;
                   rdfs:label "is persona of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isProfessionOf
currkg:isProfessionOf rdf:type owl:ObjectProperty ;
                      rdfs:domain currkg:Profession ;
                      rdfs:range currkg:Persona ;
                      rdfs:comment "Relates a profession to a persona associated with it."@en ;
                      rdfs:label "is profession of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isProvidedBy
currkg:isProvidedBy rdf:type owl:ObjectProperty ;
                    owl:inverseOf currkg:provides ;
                    rdfs:domain currkg:Media ;
                    rdfs:range currkg:Event ;
                    rdfs:comment "Relates media to an event that provides it."@en ;
                    rdfs:label "is provided by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isRecommendedFor
currkg:isRecommendedFor rdf:type owl:ObjectProperty ;
                        rdfs:domain currkg:Audience ;
                        rdfs:range currkg:Media ;
                        rdfs:comment "Relates an audience to media recommended for it."@en ;
                        rdfs:label "is recommended for"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isReferencedBy
currkg:isReferencedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf currkg:references ;
                      rdfs:domain currkg:Media ;
                      rdfs:range currkg:Module ;
                      rdfs:comment "Relates media to a module that references it."@en ;
                      rdfs:label "is referenced by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isReferredToBy
currkg:isReferredToBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf currkg:refersTo ;
                      rdfs:domain currkg:Module ;
                      rdfs:range currkg:LearningStep ;
                      rdfs:comment "Relates a module to a learning step that refers to it."@en ;
                      rdfs:label "is referred to by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isSubEventOf
currkg:isSubEventOf rdf:type owl:ObjectProperty ;
                    rdfs:domain currkg:Event ;
                    rdfs:range currkg:Event ;
                    rdfs:comment "Relates a sub-event to the event of which it is a part."@en ;
                    rdfs:label "is sub-event of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isThemeOf
currkg:isThemeOf rdf:type owl:ObjectProperty ;
                 rdfs:domain currkg:Theme ;
                 rdfs:range currkg:Module ;
                 rdfs:comment "Relates a theme to a module organized under it."@en ;
                 rdfs:label "is theme of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#isTypeOf
currkg:isTypeOf rdf:type owl:ObjectProperty ;
                rdfs:domain currkg:PersonaType ;
                rdfs:range currkg:Persona ;
                rdfs:comment "Relates a persona type to a persona classified by it."@en ;
                rdfs:label "is type of"@en .


###  https://kastle-lab.org/currkg/lod/ontology#narrowerThan
currkg:narrowerThan rdf:type owl:ObjectProperty ;
                    rdfs:domain currkg:Topic ;
                    rdfs:range currkg:Topic ;
                    rdfs:comment "Represents the relation of a topic to a narrower (more specific) topic."@en ;
                    rdfs:label "narrower than"@en .


###  https://kastle-lab.org/currkg/lod/ontology#provides
currkg:provides rdf:type owl:ObjectProperty ;
                rdfs:domain currkg:Event ;
                rdfs:range currkg:Media ;
                rdfs:comment "Represents the relation of an event to media resources it provides."@en ;
                rdfs:label "provides"@en .


###  https://kastle-lab.org/currkg/lod/ontology#references
currkg:references rdf:type owl:ObjectProperty ;
                  rdfs:domain currkg:Module ;
                  rdfs:range currkg:Media ;
                  rdfs:comment "Represents the relation of a module (or other entity) to media resources that it references."@en ;
                  rdfs:label "references"@en .


###  https://kastle-lab.org/currkg/lod/ontology#refersTo
currkg:refersTo rdf:type owl:ObjectProperty ;
                rdfs:domain currkg:LearningStep ;
                rdfs:range currkg:Module ;
                rdfs:comment "Represents the relation of a learning step to the module it refers to."@en ;
                rdfs:label "refers to"@en .


###  https://kastle-lab.org/currkg/lod/ontology#related
currkg:related rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:domain currkg:Topic ;
               rdfs:range currkg:Topic ;
               rdfs:comment "Relates two topics that are associated without asserting a hierarchical relationship."@en ;
               rdfs:label "related"@en .


###  https://kastle-lab.org/currkg/lod/ontology#scopedBy
currkg:scopedBy rdf:type owl:ObjectProperty ;
                owl:inverseOf currkg:scopes ;
                rdfs:domain currkg:LearningPath ;
                rdfs:range currkg:Curriculum ;
                rdfs:comment "Represents the relation of a learning path to the curriculum that scopes it."@en ;
                rdfs:label "scoped by"@en .


###  https://kastle-lab.org/currkg/lod/ontology#scopes
currkg:scopes rdf:type owl:ObjectProperty ;
              rdfs:domain currkg:Curriculum ;
              rdfs:range currkg:LearningPath ;
              rdfs:comment "Relates a curriculum to a learning path that it scopes."@en ;
              rdfs:label "scopes"@en .


#################################################################
#    Data properties
#################################################################

###  https://kastle-lab.org/currkg/lod/ontology#asString
currkg:asString rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( currkg:Event
                                            currkg:LearningPath
                                            currkg:LearningStep
                                            currkg:Persona
                                            currkg:PersonaType
                                            currkg:Profession
                                            currkg:Topic
                                          )
                            ] ;
                rdfs:range xsd:string ;
                rdfs:comment "Provides a string lexicalization or label for a resource."@en ;
                rdfs:label "as string"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasMediaSourceLink
currkg:hasMediaSourceLink rdf:type owl:DatatypeProperty ;
                          rdfs:domain currkg:Media ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Provides the source link or URL string for a media resource."@en ;
                          rdfs:label "has media source link"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasName
currkg:hasName rdf:type owl:DatatypeProperty ;
               rdfs:domain currkg:Author ;
               rdfs:range xsd:string ;
               rdfs:comment "Provides a human-readable name string for a resource."@en ;
               rdfs:label "has name"@en .


###  https://kastle-lab.org/currkg/lod/ontology#hasTitle
currkg:hasTitle rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( currkg:Curriculum
                                            currkg:Media
                                            currkg:Module
                                          )
                            ] ;
                rdfs:range xsd:string ;
                rdfs:comment "Provides a title string for a resource."@en ;
                rdfs:label "has title"@en .


#################################################################
#    Classes
#################################################################

###  https://kastle-lab.org/currkg/lod/ontology#Article
currkg:Article rdf:type owl:Class ;
               rdfs:subClassOf currkg:Media ;
               <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "46.144836640895754"^^xsd:double ;
                                                                            <http://ontologydesignpatterns.org/opla-sd#entityPositionY> "247.41338370020338"^^xsd:double ;
                                                                            rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en
                                                                          ] ;
               rdfs:comment "Represents an Article is a written media resource, typed as a sub-class."@en ;
               rdfs:label "Article"@en .


###  https://kastle-lab.org/currkg/lod/ontology#Audience
currkg:Audience rdf:type owl:Class ;
                rdfs:comment "Represents audience as a controlled vocabulary that is used to indicate intended audience for a media resource."@en ;
                rdfs:label "Audience"@en .


###  https://kastle-lab.org/currkg/lod/ontology#Author
currkg:Author rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty currkg:hasName ;
                                owl:someValuesFrom xsd:string
                              ] ;
              <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "212.2044628151925"^^xsd:double ;
                                                                           <http://ontologydesignpatterns.org/opla-sd#entityPositionY> "117.51617792023181"^^xsd:double ;
                                                                           rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en
                                                                         ] ;
              rdfs:comment "Represents an author that is a person who creates or is credited for media resources."@en ;
              rdfs:label "Author"@en ;
              currkg:isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/agentrole> ,
                                <https://archive.org/services/purl/domain/modular_ontology_design_library/role-dependent-name> .


###  https://kastle-lab.org/currkg/lod/ontology#CaseStudy
currkg:CaseStudy rdf:type owl:Class ;
                 rdfs:subClassOf currkg:Media ;
                 rdfs:comment "Represents a case study as a media resource presenting an in-depth examination of a situation or example."@en ;
                 rdfs:label "Case Study"@en .


###  https://kastle-lab.org/currkg/lod/ontology#Curriculum
currkg:Curriculum rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty <https://id.cfainstitute.org/ns/addresses> ;
                                    owl:someValuesFrom currkg:Theme
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty currkg:hasModule ;
                                    owl:someValuesFrom currkg:Module
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty currkg:hasTitle ;
                                    owl:someValuesFrom xsd:string
                                  ] ;
                  <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "84.22046954254326"^^xsd:double ;
                                                                               <http://ontologydesignpatterns.org/opla-sd#entityPositionY> "61.85682749202153"^^xsd:double ;
                                                                               rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en
                                                                             ] ;
                  rdfs:comment "Represents a Curriculum as a curated course of study that groups modules into a coherent educational offering."@en ;
                  rdfs:label "Curriculum"@en ;
                  currkg:isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/namestub> .


###  https://kastle-lab.org/currkg/lod/ontology#Event
currkg:Event rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:provides ;
                               owl:someValuesFrom currkg:Media
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty currkg:hasSubEvent ;
                               owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                               owl:onClass currkg:Event
                             ] ;
             <http://ontologydesignpatterns.org/opla-sd#entityPosition> [ <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "222.95598092682775"^^xsd:double ;
                                                                          <http://ontologydesignpatterns.org/opla-sd#entityPositionY> "20.29786947182403"^^xsd:double ;
                                                                          rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en
                                                                        ] ;
             rdfs:comment "Represents an event as a structured learning activity (e.g., workshop, tutorial, presentation) that can provide media and have sub-events."@en ;
             rdfs:label "Event"@en ;
             currkg:isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/event> .


###  https://kastle-lab.org/currkg/lod/ontology#Figure
currkg:Figure rdf:type owl:Class ;
              rdfs:subClassOf currkg:Media ;
