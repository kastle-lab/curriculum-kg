###  https://kastle-lab.org/currkg/lod/ontology#Persona
:Persona rdf:type owl:Class ;
         rdfs:subClassOf :ParticipantRole ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasType ;
                           owl:someValuesFrom :PersonaType
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isPersonaOf ;
                           owl:someValuesFrom :Person
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :determines ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :LearningPath
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasProfession ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Profession
                         ] ;
         <http://ontologydesignpatterns.org/opla-sd#entityPosition> _:genid67 ;
         rdfs:comment "Represents Persona as an audience profile (role/background) used to tailor a learning path.e"@en ;
         rdfs:label "Persona"@en ;
         :isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/role-dependent-name> .

