###  https://kastle-lab.org/currkg/lod/ontology#LearningPath
:LearningPath rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :hasLearningStep ;
                                owl:someValuesFrom :LearningStep
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :isDeterminedBy ;
                                owl:someValuesFrom :Persona
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :scopedBy ;
                                owl:someValuesFrom :Curriculum
                              ] ;
              <http://ontologydesignpatterns.org/opla-sd#entityPosition> _:genid39 ;
              rdfs:comment "Represents a Learning Path as an ordered sequence of learning steps tailored to a persona and scoped by a curriculum."@en ;
              rdfs:label "Learning Path"@en .

_:genid39 <http://ontologydesignpatterns.org/opla-sd#entityPositionX> "299.49419969429334"^^xsd:double ;
