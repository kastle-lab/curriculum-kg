###  https://kastle-lab.org/currkg/lod/ontology#Media
:Media rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :coversTopic ;
                         owl:someValuesFrom :Topic
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAuthor ;
                         owl:someValuesFrom :Author
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasLanguage ;
                         owl:someValuesFrom :Language
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasRecomended ;
                         owl:someValuesFrom :Audience
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasMediaSourceLink ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasTitle ;
                         owl:someValuesFrom xsd:string
                       ] ;
       <http://ontologydesignpatterns.org/opla-sd#entityPosition> _:genid53 ;
       rdfs:comment "Represents a Media that is a learning resource (e.g., article, video, podcast, transcript) and can be referenced by modules or provided by events."@en ;
       rdfs:label "Media"@en ;
       :isNativeTo <https://archive.org/services/purl/domain/modular_ontology_design_library/reporting-event> .

