           rdfs:comment "This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view."@en .


###  https://kastle-lab.org/currkg/lod/ontology#LearningStep
:LearningStep rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :hasNextLearningStep ;
                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                owl:onClass :LearningStep
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasPreviousLearningStep ;
                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                owl:onClass :LearningStep
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :refersTo ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Module
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasNextLearningStep ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :LearningStep
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasPreviousLearningStep ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :LearningStep
                              ] ;
              <http://ontologydesignpatterns.org/opla-sd#entityPosition> _:genid45 ;
              rdfs:comment "Represents a Learning Step as an ordered step within a Learning Path that refers to exactly one module."@en ;
              rdfs:label "Learning Step"@en ;
