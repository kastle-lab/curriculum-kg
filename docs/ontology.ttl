###  https://kastle-lab.org/currkg/lod/ontology#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :assumesAuthorship ;
                          owl:someValuesFrom :Author
