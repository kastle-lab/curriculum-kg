#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
   owl:members ( :Article
                 :CaseStudy
                 :Figure
                 :Formula
                 :GlossaryItem
                 :Lesson
                 :Podcast
                 :Section
                 :Table
                 :Transcript
                 :Video
                 :WorkedExample
               )
 ] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Presentation
                :Tutorial
                :Workshop
              )
] .


