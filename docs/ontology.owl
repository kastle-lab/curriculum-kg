<?xml version="1.0"?>
<rdf:RDF xmlns="https://kastle-lab.org/currkg/lod/ontology#"
     xml:base="https://kastle-lab.org/currkg/lod/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:opla-sd="http://ontologydesignpatterns.org/opla-sd#"
     xmlns:ontology="https://kastle-lab.org/currkg/lod/ontology#">
    <owl:Ontology rdf:about="https://kastle-lab.org/currkg/lod/ontology#"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ontologydesignpatterns.org/opla-sd#entityPosition -->


    <owl:AnnotationProperty rdf:about="http://ontologydesignpatterns.org/opla-sd#entityPosition"/>
    


    <!-- http://ontologydesignpatterns.org/opla-sd#entityPositionX -->


    <owl:AnnotationProperty rdf:about="http://ontologydesignpatterns.org/opla-sd#entityPositionX"/>
    


    <!-- http://ontologydesignpatterns.org/opla-sd#entityPositionY -->


    <owl:AnnotationProperty rdf:about="http://ontologydesignpatterns.org/opla-sd#entityPositionY"/>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isNativeTo -->


    <owl:AnnotationProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isNativeTo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://id.cfainstitute.org/ns/addresses -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/addresses">
        <rdfs:label xml:lang="en">addresses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/contrastsWith -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/contrastsWith">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/influences -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/influences">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/isDisclosedIn -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/isDisclosedIn">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/isbasisFor -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/isbasisFor">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/measures -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/measures">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://id.cfainstitute.org/ns/setsRequirementsFor -->


    <owl:ObjectProperty rdf:about="https://id.cfainstitute.org/ns/setsRequirementsFor">
        <rdfs:subPropertyOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#related"/>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#assumesAuthorship -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#assumesAuthorship">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isAuthorshipOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Person"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Author"/>
        <rdfs:comment xml:lang="en">Represents the relation of a person to an author role they assume.</rdfs:comment>
        <rdfs:label xml:lang="en">assumes authorship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#assumesPersona -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#assumesPersona">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isPersonaOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Person"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:comment xml:lang="en">Represents the relation of a person to a persona role they assume.</rdfs:comment>
        <rdfs:label xml:lang="en">assumes persona</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#belongTo -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#belongTo">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Theme"/>
        <rdfs:comment xml:lang="en">Represents the relation of a module to the category it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#broaderThan -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#broaderThan">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#narrowerThan"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Topic"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Topic"/>
        <rdfs:comment xml:lang="en">Represents the relation of a topic to a broader (more general) topic.</rdfs:comment>
        <rdfs:label xml:lang="en">broader than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#coversTopic -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#coversTopic">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isCoveredBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kastle-lab.org/currkg/lod/ontology#Media"/>
                    <rdf:Description rdf:about="https://kastle-lab.org/currkg/lod/ontology#Module"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Topic"/>
        <rdfs:comment xml:lang="en">Represents the relation of a module or media resource to a topic it covers.</rdfs:comment>
        <rdfs:label xml:lang="en">covers topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#determines -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#determines">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isDeterminedBy"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningPath"/>
        <rdfs:comment xml:lang="en">Represents the relation of a persona to the learning path it determines.</rdfs:comment>
        <rdfs:label xml:lang="en">determines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasAuthor -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasAuthor">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isAuthorOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Author"/>
        <rdfs:comment xml:lang="en">Represents the relation of a media resource to its author.</rdfs:comment>
        <rdfs:label xml:lang="en">has author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasLanguage -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasLanguage">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isLanguageOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Language"/>
        <rdfs:comment xml:lang="en">Represents the relation of a media resource to the language it is in.</rdfs:comment>
        <rdfs:label xml:lang="en">has language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasLearningStep -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasLearningStep">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isLearningStepOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningPath"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:comment xml:lang="en">Represents the relation of a learning path to a learning step that it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">has learning step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasLevel -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasLevel">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isLevelOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Level"/>
        <rdfs:comment xml:lang="en">Represents the relation of a module to its difficulty level.</rdfs:comment>
        <rdfs:label xml:lang="en">has level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasModule -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasModule">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isModuleOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Curriculum"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:comment xml:lang="en">Represents the relation of referring a curriculum to a module that is part of that curriculum.</rdfs:comment>
        <rdfs:label xml:lang="en">has module</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasNextLearningStep -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasNextLearningStep">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#hasPreviousLearningStep"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:comment xml:lang="en">Represents the relation of a learning step to the next learning step in the sequence.</rdfs:comment>
        <rdfs:label xml:lang="en">has next learning step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasPreviousLearningStep -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasPreviousLearningStep">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:comment xml:lang="en">Represents the relation of a learning step to the previous learning step in the sequence.</rdfs:comment>
        <rdfs:label xml:lang="en">has previous learning step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasProfession -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasProfession">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isProfessionOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Profession"/>
        <rdfs:comment xml:lang="en">Represents the relation of a persona to its profession.</rdfs:comment>
        <rdfs:label xml:lang="en">has profession</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasRecomended -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasRecomended">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isRecommendedFor"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Audience"/>
        <rdfs:comment xml:lang="en">Represents the relation of a media resource to an intended audience it is recommended for.</rdfs:comment>
        <rdfs:label xml:lang="en">has recommended audience</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasSubEvent -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasSubEvent">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isSubEventOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Event"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Event"/>
        <rdfs:comment xml:lang="en">Represents the relation of an event to a sub-event that is part of it.</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasTheme -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasTheme">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isThemeOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Theme"/>
        <rdfs:comment xml:lang="en">Relates a module to a theme that organizes its content.</rdfs:comment>
        <rdfs:label xml:lang="en">has theme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#hasType -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#hasType">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#isTypeOf"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#PersonaType"/>
        <rdfs:comment xml:lang="en">Represents the relation of a persona to its persona type.</rdfs:comment>
        <rdfs:label xml:lang="en">has type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isAuthorOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isAuthorOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Author"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:comment xml:lang="en">Relates an author role to media authored in that role.</rdfs:comment>
        <rdfs:label xml:lang="en">is author of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isAuthorshipOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isAuthorshipOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Author"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Person"/>
        <rdfs:comment xml:lang="en">Relates an author role to the person who assumes it.</rdfs:comment>
        <rdfs:label xml:lang="en">is authorship of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isCoveredBy -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isCoveredBy">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Topic"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kastle-lab.org/currkg/lod/ontology#Media"/>
                    <rdf:Description rdf:about="https://kastle-lab.org/currkg/lod/ontology#Module"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Relates a topic to media or modules that cover it.</rdfs:comment>
        <rdfs:label xml:lang="en">is covered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isDeterminedBy -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isDeterminedBy">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningPath"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:comment xml:lang="en">Relates a learning path to the persona that determines it.</rdfs:comment>
        <rdfs:label xml:lang="en">is determined by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isLanguageOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isLanguageOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Language"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:comment xml:lang="en">Relates a language to media expressed in that language.</rdfs:comment>
        <rdfs:label xml:lang="en">is language of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isLearningStepOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isLearningStepOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningStep"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#LearningPath"/>
        <rdfs:comment xml:lang="en">Relates a learning step to the learning path that contains it.</rdfs:comment>
        <rdfs:label xml:lang="en">is learning step of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isLevelOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isLevelOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Level"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:comment xml:lang="en">Relates a difficulty level to a module assigned that level.</rdfs:comment>
        <rdfs:label xml:lang="en">is level of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isModuleOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isModuleOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Curriculum"/>
        <rdfs:comment xml:lang="en">Relates a module to the curriculum that contains it.</rdfs:comment>
        <rdfs:label xml:lang="en">is module of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isPersonaOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isPersonaOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Person"/>
        <rdfs:comment xml:lang="en">Relates a persona role to the person who assumes it.</rdfs:comment>
        <rdfs:label xml:lang="en">is persona of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isProfessionOf -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isProfessionOf">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Profession"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Persona"/>
        <rdfs:comment xml:lang="en">Relates a profession to a persona associated with it.</rdfs:comment>
        <rdfs:label xml:lang="en">is profession of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isProvidedBy -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isProvidedBy">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#provides"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Event"/>
        <rdfs:comment xml:lang="en">Relates media to an event that provides it.</rdfs:comment>
        <rdfs:label xml:lang="en">is provided by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isRecommendedFor -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isRecommendedFor">
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Audience"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:comment xml:lang="en">Relates an audience to media recommended for it.</rdfs:comment>
        <rdfs:label xml:lang="en">is recommended for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isReferencedBy -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isReferencedBy">
        <owl:inverseOf rdf:resource="https://kastle-lab.org/currkg/lod/ontology#references"/>
        <rdfs:domain rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Media"/>
        <rdfs:range rdf:resource="https://kastle-lab.org/currkg/lod/ontology#Module"/>
        <rdfs:comment xml:lang="en">Relates media to a module that references it.</rdfs:comment>
        <rdfs:label xml:lang="en">is referenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-lab.org/currkg/lod/ontology#isReferredToBy -->


    <owl:ObjectProperty rdf:about="https://kastle-lab.org/currkg/lod/ontology#isReferredToBy">
